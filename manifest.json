{
  "manifest_version": 3,
  "name": "Boden Label Assistant",
  "version": "1.0.0",
  "description": "Phím tắt và quản lý tổ hợp phí cho BodenAI Labeling",
  "permissions": ["storage"],
  "host_permissions": ["https://base.bodenai.com/*"],
  "content_scripts": [
    {
      "matches": ["https://base.bodenai.com/ads-3d4d/*"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["sidebar/*", "content/page-bridge.js"],
      "matches": ["https://base.bodenai.com/*"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
